---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SeoContent from '../components/SeoContent.astro';
import Advantages from '../components/Advantages.astro';
import Services from '../components/Services.astro';
import Areas from '../components/Areas.astro';
import FAQ from '../components/FAQ.astro';
import LatestPosts from '../components/LatestPosts.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Footer from '../components/Footer.astro';
import Map from '../components/Map.astro';
---
<Layout
  title="Reboque e Guincho de Moto RJ 24h | Rio de Janeiro e Baixada Fluminense — Moto Socorro RJ"
  description="Serviço rápido e seguro de reboque e guincho para motos 24 horas no Rio de Janeiro e Baixada Fluminense. Atendemos Nova Iguaçu, Campo Grande, Av. Brasil e toda a cidade. Ligue agora!"
>
  <Header />
  <main>
    <Hero />
    <SeoContent />
    <Advantages />
    <Services />
    <Areas />
    <CtaBanner />
    <FAQ />
    <LatestPosts />
    <Map />
  </main>
  <Footer />
</Layout>
