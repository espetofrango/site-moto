---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Layout title="Blog — Moto Socorro RJ | Dicas sobre Motos e Reboque" description="Artigos, dicas e informações sobre motos, reboque, trânsito e segurança no Rio de Janeiro e Baixada Fluminense.">
  <Header />
  <main>
    <section class="blog-header">
      <div class="container">
        <h1 class="section-title">Blog <span class="accent">Moto Socorro RJ</span></h1>
        <p class="section-subtitle">Dicas, informações e novidades sobre motos, reboque e trânsito no Rio de Janeiro.</p>
      </div>
    </section>
    <section style="padding-bottom: 5rem;">
      <div class="container">
        <div class="posts-grid">
          {posts.map(post => (
            <a href={`/blog/${post.slug}`} class="post-card glass-card">
              <div class="post-card-body">
                <div class="post-card-date">
                  {post.data.pubDate.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })}
                </div>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <span class="post-card-link">Ler mais →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
