<section class="section" id="localizacao">
  <div class="container">
    <h2 class="section-title">Nossa <span class="accent">Localização</span></h2>
    <p class="section-subtitle">Estamos estrategicamente localizados para garantir um atendimento rápido em toda a região.</p>
    <div class="map-container glass-card" style="padding: 0.5rem; border-radius: 12px; overflow: hidden;">
      <iframe 
        src="https://maps.google.com/maps?q=-22.853343,-43.394428&t=&z=15&ie=UTF8&iwloc=&output=embed" 
        width="100%" 
        height="400" 
        style="border:0; border-radius: 8px; display: block;" 
        allowfullscreen="" 
        loading="lazy" 
        referrerpolicy="no-referrer-when-downgrade">
      </iframe>
    </div>
  </div>
</section>
